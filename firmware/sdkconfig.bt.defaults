# Bluetooth build (env:bt), layered over sdkconfig.defaults.
# docs/bluetooth/architecture.md — switch mode: Wi-Fi OR Bluetooth.

# Bluedroid host + dual-mode (Classic BR/EDR + BLE) controller.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y

# Observer only: no GATT server, no pairing, no Classic profiles.
# The GATT client stays for later operator-initiated discovery.
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=n
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_HFP_ENABLE=n
CONFIG_BT_L2CAP_ENABLED=n
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1

# IRAM: Wi-Fi + Bluedroid overflow the ESP32's instruction RAM (by 1448 bytes
# with all defaults). Move the general Wi-Fi hot paths to flash (ESP-IDF's own
# default for ESP32+BT+PSRAM). The RX path a sniffer depends on stays in IRAM
# (ESP_WIFI_RX_IRAM_OPT). Applies to this build only; the Wi-Fi-only builds
# keep the full optimisation. Measured on hardware: docs/bluetooth/testing.md.
CONFIG_ESP_WIFI_IRAM_OPT=n

# The board has 4 MB of flash; the Bluedroid image needs a larger app
# partition than the 1 MB default (partitions_bt.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_bt.csv"
